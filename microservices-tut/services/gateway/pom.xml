<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.swiftcart</groupId>
    <artifactId>swiftcart-parent</artifactId>
    <version>0.0.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>gateway</artifactId>
  <name>gateway</name>

  <dependencies>
    <!-- Spring Cloud Gateway is REACTIVE (webflux) — do NOT add
         spring-boot-starter-web here or it fails to start. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 📝 TIER 9 (Security): add spring-boot-starter-oauth2-resource-server to
         validate JWTs at the edge (authenticate once here, propagate identity
         to services). Newman Ch 11: the gateway is a natural policy enforcement
         point, but beware making it a smart monolith — keep it thin. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
