# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required to run the full
# pipeline; the retrieval half + eval run with NO keys (local embeddings).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# GEN_MODEL=claude-haiku-4-5-20251001
# EMBEDDINGS_PROVIDER=fastembed          # or: openai
# OPENAI_API_KEY=sk-...                  # only if EMBEDDINGS_PROVIDER=openai
# PG_DSN=postgresql://rag:rag@localhost:5433/rag
# TOP_K=4
